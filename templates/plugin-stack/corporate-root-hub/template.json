{
  "schema_version": "zcg-template-v1",
  "name": "corporate-root-hub",
  "kind": "plugin-stack",
  "stack_group": "plugin-stack",
  "extends": "corporate-operations",
  "target_role": "corporate",
  "description": "Root 0 Corporate Governance Hub cockpit unifying departmental topology, RBAC rosters, and charter gates.",
  "runtime_service": {
    "service_id": "corporate-root-hub",
    "framework": "zero-build-html-cockpit",
    "bound_surfaces": ["surfaces/web/", "surfaces/data/"],
    "healthcheck_endpoint": "/healthz",
    "enabled_modules": ["node_mesh", "work_ledger", "crud", "vault", "data_pipeline"],
    "web_assets": {
      "templates_dir": "web/templates",
      "static_dir": "web/static"
    },
    "delivery_channel": {
      "protocol": "python314-native-asgi",
      "zones": ["Z1", "Z2", "Z3", "Z4"],
      "default_tier": "T1",
      "latency_budget_ms": 200,
      "http_poll_stop_status": 286,
      "telemetry_sink": ".agents/telemetry"
    }
  },
  "recommended_surface_bindings": []
}
