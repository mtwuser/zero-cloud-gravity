{
  "schema_version": "zcg-template-v1",
  "name": "knowledge-stewardship-portal",
  "kind": "plugin-stack",
  "stack_group": "plugin-stack",
  "extends": "scientific-methodology",
  "target_role": "knowledge",
  "description": "Zero-build Epistemic Knowledge & Data Pipeline Stewardship Portal for public and institutional gov-*, sci-*, geo-*, and org-* corpora (:8720).",
  "runtime_service": {
    "service_id": "knowledge-stewardship-portal",
    "framework": "zero-build-html-cockpit",
    "bound_surfaces": ["surfaces/web/", "surfaces/data/"],
    "healthcheck_endpoint": "/healthz",
    "enabled_modules": ["data_pipeline", "crud", "vault", "node_mesh"],
    "web_assets": {
      "templates_dir": "web/templates",
      "static_dir": "web/static"
    },
    "delivery_channel": {
      "protocol": "python314-native-asgi",
      "zones": ["Z1", "Z2", "Z3", "Z4"],
      "default_tier": "T1",
      "latency_budget_ms": 200,
      "http_poll_stop_status": 286,
      "telemetry_sink": ".agents/telemetry"
    }
  },
  "recommended_surface_bindings": []
}
