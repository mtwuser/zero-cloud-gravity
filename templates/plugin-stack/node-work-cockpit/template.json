{
  "schema_version": "zcg-template-v1",
  "name": "node-work-cockpit",
  "kind": "plugin-stack",
  "stack_group": "plugin-stack",
  "extends": "universal-base",
  "target_role": "squad",
  "description": "Department, Squad & Personal Work Hub Reference Dashboard composing sprint ledgers, CRUD collections, vault, role projection, and data pipelines.",
  "runtime_service": {
    "service_id": "node-work-cockpit",
    "framework": "zero-build-html-cockpit",
    "bound_surfaces": ["surfaces/web/", "surfaces/data/"],
    "healthcheck_endpoint": "/healthz",
    "enabled_modules": ["work_ledger", "crud", "vault", "node_mesh", "data_pipeline"],
    "web_assets": {
      "templates_dir": "web/templates",
      "static_dir": "web/static"
    },
    "delivery_channel": {
      "protocol": "python314-native-asgi",
      "zones": ["Z1", "Z2", "Z3", "Z4"],
      "default_tier": "T1",
      "latency_budget_ms": 200,
      "http_poll_stop_status": 286,
      "telemetry_sink": ".agents/telemetry"
    }
  },
  "recommended_surface_bindings": []
}
