{
  "schema_version": "zcg-template-v1",
  "name": "tutor-study-cockpit",
  "kind": "plugin-stack",
  "stack_group": "plugin-stack",
  "extends": "academic-curriculum",
  "target_role": "department",
  "description": "Personal & Departmental Academic Study Lab cockpit tracking M1..M4 mastery, syllabus units, and mounted corpora.",
  "runtime_service": {
    "service_id": "tutor-study-cockpit",
    "framework": "zero-build-html-cockpit",
    "bound_surfaces": ["surfaces/web/", "surfaces/data/"],
    "healthcheck_endpoint": "/healthz",
    "enabled_modules": ["crud", "vault", "node_mesh", "telemetry"],
    "web_assets": {
      "templates_dir": "web/templates",
      "static_dir": "web/static"
    },
    "delivery_channel": {
      "protocol": "python314-native-asgi",
      "zones": ["Z1", "Z2", "Z3", "Z4"],
      "default_tier": "T1",
      "latency_budget_ms": 200,
      "http_poll_stop_status": 286,
      "telemetry_sink": ".agents/telemetry"
    }
  },
  "recommended_surface_bindings": []
}
